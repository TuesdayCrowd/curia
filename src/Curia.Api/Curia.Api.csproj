<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The composition root. CS-7: host projects wire adapters into ports and contain no domain
    logic, which is why this is the only project referencing both Infrastructure and AuthN.
    The two things the hexagon keeps apart everywhere else meet here, on purpose, once.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Curia.Api</RootNamespace>
    <!--
      CA1515 ("an application's API isn't typically referenced from outside the assembly") assumes
      a host nobody links against. Curia.Api.Tests hosts this exact wiring in-process so the
      end-to-end test exercises the real composition root rather than a re-creation of it, which
      is the only version of that test worth having. The types are public for that reason.
    -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Curia.Application/Curia.Application.csproj" />
    <ProjectReference Include="../Curia.Infrastructure/Curia.Infrastructure.csproj" />
    <ProjectReference Include="../Curia.AuthN/Curia.AuthN.csproj" />
    <ProjectReference Include="../Curia.Canon.Sodium/Curia.Canon.Sodium.csproj" />
  </ItemGroup>

</Project>
