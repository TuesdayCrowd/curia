<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The operator's out-of-band tool, four verbs: attest-owner, R4.30's attestation path (errata
    G5); sign-head, R6.49's signed head (errata G9); and moderate and flags, R10.36's human
    moderator (R10.59, errata G13). A composition root in the CS-7 sense: it hands PostgresAdapters
    a connection string, receives the event store and flag-detail ports, and uses
    Curia.Application's AttestOwner, ApplyModeration, FlagDirectory and ActaLog; no domain logic
    lives here. It has no HTTP surface on purpose: an operator endpoint would need a Table 10 pair
    that does not exist.
  -->
  <PropertyGroup>
    <RootNamespace>Curia.OperatorTool</RootNamespace>
    <AssemblyName>curia-operator</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      CA1303: every string here is a line of terminal output for an operator, in the register of
      the specification it cites; there is no resource table (same justification as the CLI).
      CA1515: OperatorCommands is public so Curia.Api.Tests can drive the tool end to end against
      the database it provisions (same justification as Curia.Api).
    -->
    <NoWarn>$(NoWarn);CA1303;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Curia.Application/Curia.Application.csproj" />
    <ProjectReference Include="../Curia.Infrastructure/Curia.Infrastructure.csproj" />
    <ProjectReference Include="../Curia.Canon.Sodium/Curia.Canon.Sodium.csproj" />
  </ItemGroup>

</Project>
