using System.Diagnostics.CodeAnalysis;
using Curia.Domain.Acta;
using Xunit;

namespace Curia.Architecture.Tests;

/// <summary>
/// PR N2 (errata G70, R6.66), Task 1: OAS18, kept as <c>.cs.pending</c> because it names <c>LogEntries.OperatorKeyType</c>, which Task 2 adds (a test file naming a type that does not exist breaks the whole assembly's build).
/// HSU6's every-<c>LogEntries</c>-type-is-decided rule, for the fourth type.
/// </summary>
[SuppressMessage("Naming", "CA1707:Identifiers should not contain underscores", Justification = "Test names carry the requirement IDs they enforce verbatim.")]
public sealed class OperatorActsGuardProbes
{
    /// <summary>OAS18: <c>OperatorKeyType</c> is classified by the guard or listed in <c>Unclassified</c> with a reason.</summary>
    [Fact]
    public void OAS18_TheOperatorKeyTypeIsDecidedByTheGuard()
    {
        Assert.Equal("log.operator-key", LogEntries.OperatorKeyType);
        // Task 2 adds the row to DeclarationKeyFenceTests.Unclassified (HSU6, with its reason) and raises its count from 3 to 4; this probe is the string it pins.
    }
}
