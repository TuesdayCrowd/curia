<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      CA1515 fires on the fixture, which xUnit must construct from outside its own assembly.
      CA2234's Uri overloads add nothing to relative test paths.
      CA2007 (ConfigureAwait) guards against deadlocks when a continuation resumes on a captured
      synchronization context; xUnit v3 runs without one, and `await using var` cannot carry a
      ConfigureAwait without changing the variable's type, which would mean rewriting correct
      resource handling to satisfy a rule that does not apply here.
      Every other analyzer stays on.
    -->
    <NoWarn>$(NoWarn);CA1515;CA2234;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Curia.Api/Curia.Api.csproj" />
    <!-- The operator tool is driven end to end against the database this suite provisions (R4.30). -->
    <ProjectReference Include="../../src/Curia.Operator/Curia.Operator.csproj" />
    <!--
      The reference client, driven against the Forum this suite provisions. R6.52's three checks
      are a client obligation, so the only place they can be exercised against a real Acta with a
      real operator-signed head is here.
    -->
    <ProjectReference Include="../../src/Curia.Client/Curia.Client.csproj" />
    <!--
      The MCP adapter, whose write tools are driven end to end against this Forum: the MCP plan's
      Stage 4 names "a write through MCP produces an envelope that curia-testis verifies offline" as
      the strongest single assertion available, and only this suite has a Forum to write to.
    -->
    <ProjectReference Include="../../src/Curia.Mcp/Curia.Mcp.csproj" />
    <!--
      The `curia` command, run as a child process against the Forum this suite binds to a port (D48):
      the revision verb's composition (which digest it reads, what it signs) is the CLI's own and was
      never run against a Forum. A reference is what builds it into this suite's output.
    -->
    <ProjectReference Include="../../src/Curia.Client.Cli/Curia.Client.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The stub Forum the client and adapter suites are proved against, compiled here as well so
      StubFidelityTests can hold what it serves against what this Forum serves. A fixture checked
      only against itself agrees with whatever its authors believed, which is trap 12.
    -->
    <Compile Include="../Shared/StubLog.cs" Link="Shared/StubLog.cs" />
    <Compile Include="../Shared/PublishedAcceptBudget.cs" Link="Shared/PublishedAcceptBudget.cs" />
    <Compile Include="../Shared/ConflictingEventStore.cs" Link="Shared/ConflictingEventStore.cs" />
    <Compile Include="../Shared/PublishedSearchPage.cs" Link="Shared/PublishedSearchPage.cs" />
    <Compile Include="../Shared/PublishedSmallWords.cs" Link="Shared/PublishedSmallWords.cs" />
    <Compile Include="../Shared/PublishedParentRule.cs" Link="Shared/PublishedParentRule.cs" />
    <Compile Include="../Shared/PublishedRevisionSlugs.cs" Link="Shared/PublishedRevisionSlugs.cs" />
    <Compile Include="../Shared/PublishedWithheldWords.cs" Link="Shared/PublishedWithheldWords.cs" />
    <Compile Include="../Shared/PublishedForkWords.cs" Link="Shared/PublishedForkWords.cs" />
    <Compile Include="../Shared/PublishedCliRules.cs" Link="Shared/PublishedCliRules.cs" />
    <Compile Include="../Shared/PublishedReadersWords.cs" Link="Shared/PublishedReadersWords.cs" />
    <Compile Include="../Shared/McpProtocolSession.cs" Link="Shared/McpProtocolSession.cs" />
    <!-- GF9: the refusal documents a guarded Forum serves a lifecycle route; StubLog's guarded mode serves them, and Curia.Api.Tests holds them to the real Forum. -->
    <Compile Include="../Shared/LifecycleRefusals.cs" Link="Shared/LifecycleRefusals.cs" />
    <!-- R11.20's external signer, a real process: tests/Shared/test-signer.py reached through a per-test symlink (D44). -->
    <Compile Include="../Shared/TestSigner.cs" Link="Shared/TestSigner.cs" />
    <!-- R4.15's rows, named once: the adapter suite asks the verifiers about the same materials. -->
    <Compile Include="../Shared/KeyMaterials.cs" Link="Shared/KeyMaterials.cs" />
    <!-- R4.38 (add.): the test composition's gate, linked so each test assembly holds its own internal copy. -->
    <Compile Include="../Shared/PermissiveLifecycleAppendGate.cs" Link="Shared/PermissiveLifecycleAppendGate.cs" />
  </ItemGroup>

</Project>
