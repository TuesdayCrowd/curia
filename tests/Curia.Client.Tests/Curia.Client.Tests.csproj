<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      CA1515 fires on types xUnit must construct from outside the assembly.
      CA2007 (ConfigureAwait) guards against deadlocks when a continuation resumes on a captured
      synchronization context; xUnit v3 runs without one. Same justification Curia.Api.Tests records.
      Every other analyzer stays on.
    -->
    <NoWarn>$(NoWarn);CA1515;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Curia.Client/Curia.Client.csproj" />
    <ProjectReference Include="../../src/Curia.Client.Cli/Curia.Client.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      One stub Forum, compiled into both suites. R6.51's exemption and R11.18's obligation are
      claims about the same material reaching two surfaces, so a second copy of the fixture is a
      second thing to keep in step, and the first member to drift would be the marker whose
      absence is the assertion.
    -->
    <Compile Include="../Shared/PublishedReadersLastWords.cs" Link="Shared/PublishedReadersLastWords.cs" />
    <Compile Include="../Shared/StubLog.cs" Link="Shared/StubLog.cs" />
    <Compile Include="../Shared/PublishedRecheck.cs" Link="Shared/PublishedRecheck.cs" />
    <Compile Include="../Shared/PublishedReadersWords.cs" Link="Shared/PublishedReadersWords.cs" />
    <Compile Include="../Shared/PublishedChainWords.cs" Link="Shared/PublishedChainWords.cs" />
    <Compile Include="../Shared/PublishedCliRules.cs" Link="Shared/PublishedCliRules.cs" />
    <Compile Include="../Shared/PublishedWithheldWords.cs" Link="Shared/PublishedWithheldWords.cs" />
    <Compile Include="../Shared/PublishedForkWords.cs" Link="Shared/PublishedForkWords.cs" />
    <Compile Include="../Shared/PublishedBudgetReadout.cs" Link="Shared/PublishedBudgetReadout.cs" />
    <Compile Include="../Shared/PublishedAcceptBudget.cs" Link="Shared/PublishedAcceptBudget.cs" />
    <!-- Errata G48 (R7.27, R11.64): the gate's numbers, types and words, read from the errata. -->
    <Compile Include="../Shared/PublishedBudgetGate.cs" Link="Shared/PublishedBudgetGate.cs" />
    <Compile Include="../Shared/PublishedSearchPage.cs" Link="Shared/PublishedSearchPage.cs" />
    <Compile Include="../Shared/PublishedSmallWords.cs" Link="Shared/PublishedSmallWords.cs" />
    <!-- GF9: the refusal documents a guarded Forum serves a lifecycle route; StubLog's guarded mode serves them, and Curia.Api.Tests holds them to the real Forum. -->
    <Compile Include="../Shared/LifecycleRefusals.cs" Link="Shared/LifecycleRefusals.cs" />
    <!-- R11.20's external signer, a real process: tests/Shared/test-signer.py reached through a per-test symlink (D44). -->
    <Compile Include="../Shared/TestSigner.cs" Link="Shared/TestSigner.cs" />
    <!--
      D37: the tier reminder is checked against Table 10 as the white paper publishes it, parsed by the
      same reader R7.12's denial facts use, so the help and the code are each held to the table.
    -->
    <Compile Include="../Curia.Domain.Tests/Authorization/PublishedTable11.cs" Link="Shared/PublishedTable11.cs" />
    <Compile Include="../Curia.Domain.Tests/Authorization/PublishedTable10.cs" Link="Shared/PublishedTable10.cs" />
  </ItemGroup>

</Project>
