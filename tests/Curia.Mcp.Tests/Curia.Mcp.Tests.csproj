<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      CA1515 fires on types xUnit must construct from outside the assembly.
      CA2007 (ConfigureAwait) guards against deadlocks when a continuation resumes on a captured
      synchronization context; xUnit v3 runs without one. Same justification Curia.Client.Tests
      and Curia.Api.Tests record. Every other analyzer stays on.
    -->
    <NoWarn>$(NoWarn);CA1515;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Curia.Mcp/Curia.Mcp.csproj" />
    <ProjectReference Include="../../src/Curia.Client/Curia.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      One stub Forum, compiled into both suites. R6.51's exemption and R11.18's obligation are
      claims about the same material reaching two surfaces, so a second copy of the fixture is a
      second thing to keep in step, and the first member to drift would be the marker whose
      absence is the assertion.
    -->
    <Compile Include="../Shared/StubLog.cs" Link="Shared/StubLog.cs" />
  </ItemGroup>

</Project>
