# /etc/curia/forum.env, mode 0600, owned by the Forum's user (curia) and read by no one else. Names only: no value is here.
# The Forum's own four settings and nothing of the operator's: never the log key, the declaration key or the operator-acts key
# (docs/runbooks/operator-keys.md). A PEM spans lines; see docs/runbooks/head-timer.md for the multi-line form.
CURIA_EVENTS_POSTGRES=
CURIA_ISSUER_SIGNING_KEY_PEM=
CURIA_EMBEDDING_MODEL_DIR=
CURIA_PUBLIC_ORIGIN=
