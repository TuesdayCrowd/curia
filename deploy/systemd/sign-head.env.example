# /etc/curia/sign-head.env, mode 0600, owned by the head-timer user and read by no one else. Names only: no value is here.
# This file holds the LOG key and nothing else of the operator's: never the declaration key and never the operator-acts key
# (R12.18).
CURIA_EVENTS_POSTGRES=
CURIA_LOG_SIGNING_KEY_PEM=
